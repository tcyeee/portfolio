---
import { personalInfo } from '../config'
import '../styles/icon.scss'
---

<div data-footer-spacer aria-hidden="true"></div>
<footer data-footer-reveal class="fixed inset-x-0 bottom-0 z-40 bg-gray-900 text-gray-300 py-12 will-change-transform" style="transform: translateY(100%)">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div>
        <h3 class="text-xl font-bold text-white mb-4">{personalInfo.name}</h3>
        <p class="text-gray-400">{personalInfo.bio}</p>
      </div>
      <div class="pl-10">
        <h4 class="text-lg font-semibold text-white mb-4">链接</h4>
        <div class="flex gap-4 items-center">
          {
            personalInfo.github && (
              <a
                href={personalInfo.github}
                target="_blank"
                rel="noopener noreferrer"
                class="icon-github icon-size-25 text-white hover:opacity-80"
                aria-label="GitHub"
              />
            )
          }
          {
            personalInfo.twitter && (
              <a
                href={personalInfo.twitter}
                target="_blank"
                rel="noopener noreferrer"
                class="icon-twitter icon-size-21 text-white hover:opacity-80"
                aria-label="Twitter"
              />
            )
          }
          {
            personalInfo.redNote && (
              <a
                href={personalInfo.redNote}
                target="_blank"
                rel="noopener noreferrer"
                class="icon-redNote icon-size-55 text-white hover:opacity-80"
                aria-label="RedNote"
              />
            )
          }
          {
            personalInfo.bilibili && (
              <a
                href={personalInfo.bilibili}
                target="_blank"
                rel="noopener noreferrer"
                class="icon-bilibili icon-size-25 text-white hover:opacity-80"
                aria-label="Bilibili"
              />
            )
          }
        </div>
      </div>
      <div>
        <h4 class="text-lg font-semibold text-white mb-4">联系</h4>
        <div class="text-gray-400">
          <a href={`mailto:${personalInfo.email}`} class="hover:text-primary-400 transition-colors">
            {personalInfo.email}
          </a>
          <p class="text-sm mt-2">&copy; {new Date().getFullYear()} {personalInfo.name}. All rights reserved.</p>
          {
            personalInfo.icp && (
              <p class="text-sm mt-2">
                <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer" class="hover:text-primary-400 transition-colors">
                  {personalInfo.icp}
                </a>
              </p>
            )
          }
        </div>
      </div>
    </div>
  </div>
</footer>

<script>
  ;(() => {
    if (typeof window === 'undefined') return

    const footer = document.querySelector('[data-footer-reveal]') as HTMLElement | null
    const spacer = document.querySelector('[data-footer-spacer]') as HTMLElement | null
    if (!footer || !spacer) return

    // Reveal is binary: fully hidden or fully shown. `THRESHOLD` is the scroll
    // progress (through the spacer's reserved height) past which the footer
    // commits to showing; below it, the footer settles back to hidden.
    const THRESHOLD = 0.2
    const DAMPING = 0.16
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    let current = 0
    let target = 0
    let frameId = 0

    const syncSpacerHeight = () => {
      spacer.style.height = `${footer.offsetHeight}px`
    }

    const updateTarget = () => {
      const rect = spacer.getBoundingClientRect()
      const spacerHeight = rect.height || 1
      const progress = (window.innerHeight - rect.top) / spacerHeight
      const clamped = Math.min(Math.max(progress, 0), 1)
      target = clamped >= THRESHOLD ? 1 : 0
    }

    const tick = () => {
      updateTarget()
      current += (target - current) * (reduceMotion ? 1 : DAMPING)
      if (Math.abs(target - current) < 0.001) current = target
      footer.style.transform = `translateY(${(1 - current) * 100}%)`
      frameId = requestAnimationFrame(tick)
    }

    syncSpacerHeight()
    tick()

    window.addEventListener('resize', syncSpacerHeight)
    new ResizeObserver(syncSpacerHeight).observe(footer)

    window.addEventListener('pagehide', () => cancelAnimationFrame(frameId), { once: true })
  })()
</script>
