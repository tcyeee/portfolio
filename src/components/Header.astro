---
import ThemeToggle from './ThemeToggle.astro'
import { personalInfo } from '../config'

// Only the homepage has a full-viewport hero screen for the header to hide
// behind; everywhere else the header must be visible from the start.
const isHome = Astro.url.pathname === '/'

const navigation = [
  {
    name: '首页',
    href: '/',
  },
  {
    name: '项目',
    href: '/projects',
  },
  {
    name: '文章',
    href: '/articles',
  },
  {
    name: '关于',
    href: '/about',
  },
]
---

<header
  data-header-reveal
  class="fixed inset-x-0 top-0 z-50 bg-white/80 dark:bg-gray-900/80 backdrop-blur-md border-b border-gray-200 dark:border-gray-800 will-change-transform"
  style={isHome ? 'transform: translateY(-100%)' : undefined}>
  <nav class="container mx-auto px-4 py-4">
    <div class="flex items-center justify-between">
      <a
        href="/"
        class="flex items-center gap-2 text-xl md:text-2xl font-bold text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 transition-colors">
        <img src="/favicon.ico" alt="" class="h-[29px] w-[29px] md:h-[34px] md:w-[34px]" />
        {personalInfo.name}
      </a>
      <div class="flex items-center gap-3 md:gap-4">
        <ul class="flex gap-3 md:gap-6 items-center text-sm md:text-base">
          {
            navigation.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-gray-700 dark:text-gray-300 hover:text-primary-600 dark:hover:text-primary-400 transition-colors">
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
        <ThemeToggle />
      </div>
    </div>
  </nav>
</header>

<script>
  // This script tag is identical on every page, so under client-side routing
  // Astro only executes it once per session rather than on every navigation.
  // Header.astro's own markup (and whether `#hero-screen` exists) differs per
  // page, so the setup below has to be redone on every navigation via
  // `astro:page-load` (which also fires on the initial load) instead of once
  // at parse time — otherwise the reveal behavior would stick to whichever
  // page happened to load first.
  let cancelReveal = () => {}

  const setup = () => {
    cancelReveal()
    if (typeof window === 'undefined') return

    const header = document.querySelector('[data-header-reveal]') as HTMLElement | null
    if (!header) return

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    // Only the homepage has a full-viewport hero screen for the header to
    // hide behind. Everywhere else the header is already visible (no inline
    // transform) and stays put — no scroll-driven reveal needed.
    if (document.getElementById('hero-screen')) {
      // Reveal is binary: fully hidden or fully shown. The nav stays off-screen
      // for the first screen's worth of content and slides in once the user
      // scrolls into the second screen; scrolling back up above that hides it again.
      const DAMPING = 0.16

      let current = 0
      let target = 0
      let frameId = 0

      const updateTarget = () => {
        target = window.scrollY >= window.innerHeight ? 1 : 0
      }

      const tick = () => {
        updateTarget()
        current += (target - current) * (reduceMotion ? 1 : DAMPING)
        if (Math.abs(target - current) < 0.001) current = target
        header.style.transform = `translateY(${(current - 1) * 100}%)`
        frameId = requestAnimationFrame(tick)
      }

      tick()

      cancelReveal = () => cancelAnimationFrame(frameId)
    }

    // On the homepage, clicking the logo or "首页" link should just scroll to
    // top instead of reloading the page.
    const homeLinks = header.querySelectorAll<HTMLAnchorElement>('a[href="/"]')
    homeLinks.forEach((link) => {
      link.addEventListener('click', (event) => {
        if (window.location.pathname !== '/') return
        event.preventDefault()
        window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' })
      })
    })
  }

  document.addEventListener('astro:page-load', setup)
</script>
