---
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import '../styles/global.css'

interface Props {
  title: string
  description?: string
  ogImage?: string
}

const { title, description = '个人作品展示网站', ogImage = '/images/avatar.jpg' } = Astro.props
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin)

// The homepage hides the header behind its full-viewport hero, so it needs no
// extra spacing. Every other page shows the header immediately, so content
// needs top padding to clear the fixed header and avoid being covered by it.
const isHome = Astro.url.pathname === '/'
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL.toString()} />
    <link rel="alternate" type="application/rss+xml" title="RSS" href={new URL('/rss.xml', Astro.site ?? Astro.url.origin).toString()} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.toString()} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, canonicalURL).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, canonicalURL).toString()} />
    <script is:inline>
      (() => {
        const storageKey = 'theme';
        const stored = localStorage.getItem(storageKey);
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
    <!-- GoatCounter analytics: first-party, same-origin /count proxied to the self-hosted instance (site: tcyeee.stats.viii.me) -->
    <script data-goatcounter="https://tcyeee.top/count" async src="/count.js"></script>
  </head>
  <body class="bg-gray-50 text-gray-900 dark:bg-gray-900 dark:text-gray-100 flex flex-col min-h-screen">
    <Header />
    <main class={`flex-1 ${isHome ? '' : 'pt-20 md:pt-24'}`}>
      <slot />
    </main>
    <Footer />
    <script>
      import Lenis from 'lenis'
      import Snap from 'lenis/snap'

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const lenis = new Lenis({ autoRaf: true })

        // Exposed so other components (e.g. FallingIcons) can react to scroll
        // velocity without each needing their own Lenis instance.
        ;(window as typeof window & { __lenis?: Lenis }).__lenis = lenis

        // Homepage only: snap straight from the first screen to the second
        // screen (and back) so the two are never both partially visible.
        // Once the user has scrolled past the second screen, snapping is
        // disabled so the rest of the page scrolls freely.
        //
        // `lock` (not `mandatory`) is deliberate: `mandatory` snaps to
        // whichever point is nearest by distance, so it takes scrolling past
        // the halfway mark before it advances. `lock` snaps by scroll
        // direction instead, so any small downward scroll advances to the
        // next screen (and any upward scroll goes back).
        const heroEl = document.getElementById('hero-screen')
        const secondScreenEl = document.getElementById('second-screen')
        if (heroEl && secondScreenEl) {
          const snap = new Snap(lenis, { type: 'lock', distanceThreshold: Infinity })
          snap.addElement(heroEl, { align: 'start' })
          snap.addElement(secondScreenEl, { align: 'start' })

          lenis.on('scroll', (instance) => {
            const secondScreenTop = secondScreenEl.getBoundingClientRect().top + instance.scroll
            if (instance.scroll > secondScreenTop) {
              snap.stop()
            } else {
              snap.start()
            }
          })
        }
      }
    </script>
  </body>
</html>

<style is:global>
  html {
    font-family: system-ui, sans-serif;
  }
</style>
