---
import { ClientRouter } from 'astro:transitions'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import '../styles/global.css'

interface Props {
  title: string
  description?: string
  ogImage?: string
}

const { title, description = '个人作品展示网站', ogImage = '/images/avatar.jpg' } = Astro.props
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin)

// The homepage's hero section fills the viewport and sits under the
// translucent fixed header by design, so it needs no extra spacing. Every
// other page's content needs top padding to clear the fixed header.
const isHome = Astro.url.pathname === '/'
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;700&family=Noto+Serif+SC:wght@400;600;700&display=swap"
    />
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL.toString()} />
    <link rel="alternate" type="application/rss+xml" title="RSS" href={new URL('/rss.xml', Astro.site ?? Astro.url.origin).toString()} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.toString()} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, canonicalURL).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, canonicalURL).toString()} />
    <ClientRouter />
    <script is:inline>
      (() => {
        const storageKey = 'theme';

        const applyTheme = () => {
          const stored = localStorage.getItem(storageKey);
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (stored === 'dark' || (!stored && prefersDark)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        };

        applyTheme();

        // Client-side navigation replaces <html>'s attributes with the new
        // page's raw (always light-mode) markup before repainting, which
        // would otherwise flash/revert the site to light mode on every
        // navigation. Reapply immediately after that swap, before the new
        // page is painted.
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>
    <!-- GoatCounter analytics: first-party, same-origin /count proxied to the self-hosted instance (site: tcyeee.stats.viii.me).
         `no_onload` disables count.js's own automatic pageview so every pageview — including the first — goes through the
         `astro:page-load` listener below instead; without it, client-side navigations would never be counted since count.js
         only fires once on the real document load. -->
    <script is:inline>
      window.goatcounter = { no_onload: true }
    </script>
    <script data-goatcounter="https://tcyeee.top/count" async src="/count.js"></script>
    <script is:inline>
      function sendPageview(attemptsLeft) {
        if (window.goatcounter && window.goatcounter.count) {
          window.goatcounter.count({ path: location.pathname + location.search })
        } else if (attemptsLeft > 0) {
          // count.js loads async, so on a fast first navigation it may not be ready yet.
          setTimeout(() => sendPageview(attemptsLeft - 1), 50)
        }
      }
      document.addEventListener('astro:page-load', () => sendPageview(20))
    </script>
  </head>
  <body class="font-sans bg-gray-50 text-gray-900 dark:bg-gray-900 dark:text-gray-100 flex flex-col min-h-screen">
    <Header />
    <main class={`flex-1 ${isHome ? '' : 'pt-20 md:pt-24'}`} transition:animate="slide">
      <slot />
    </main>
    <Footer />
    <script>
      import Lenis from 'lenis'
      import Snap from 'lenis/snap'

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const lenis = new Lenis({ autoRaf: true })

        // Exposed so other components (e.g. FallingIcons) can react to scroll
        // velocity without each needing their own Lenis instance.
        ;(window as typeof window & { __lenis?: Lenis }).__lenis = lenis

        // This script tag is identical on every page, so under client-side
        // routing Astro only ever executes it once per session — it won't
        // re-run on later navigations. The Lenis instance above is fine to
        // keep as a singleton across the whole session, but the homepage
        // snap setup below depends on elements that only exist on the
        // homepage's freshly-swapped DOM, so it has to be redone on every
        // navigation via `astro:page-load` (which also fires on the initial
        // load) rather than once at parse time.
        let teardownSnap = () => {}

        const setupSnap = () => {
          teardownSnap()
          lenis.resize()

          // Homepage only: snap straight from the first screen to the second
          // screen (and back) so the two are never both partially visible.
          // Once the user has scrolled past the second screen, snapping is
          // disabled so the rest of the page scrolls freely.
          //
          // `lock` (not `mandatory`) is deliberate: `mandatory` snaps to
          // whichever point is nearest by distance, so it takes scrolling past
          // the halfway mark before it advances. `lock` snaps by scroll
          // direction instead, so any small downward scroll advances to the
          // next screen (and any upward scroll goes back).
          const heroEl = document.getElementById('hero-screen')
          const secondScreenEl = document.getElementById('second-screen')
          if (!heroEl || !secondScreenEl) return

          const snap = new Snap(lenis, { type: 'lock', distanceThreshold: Infinity })
          snap.addElement(heroEl, { align: 'start' })
          snap.addElement(secondScreenEl, { align: 'start' })

          const onScroll = (instance: Lenis) => {
            const secondScreenTop = secondScreenEl.getBoundingClientRect().top + instance.scroll
            if (instance.scroll > secondScreenTop) {
              snap.stop()
            } else {
              snap.start()
            }
          }
          lenis.on('scroll', onScroll)

          teardownSnap = () => {
            lenis.off('scroll', onScroll)
            snap.destroy()
          }
        }

        document.addEventListener('astro:page-load', setupSnap)
      }
    </script>
  </body>
</html>

<style is:global>
  html {
    font-family: Inter, 'Noto Sans SC', system-ui, sans-serif;
  }
</style>
