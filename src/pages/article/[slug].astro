---
import Layout from '../../layouts/Layout.astro'
import MarkdownContent from '../../components/MarkdownContent.astro'
import TableOfContents from '../../components/TableOfContents.tsx'
import fs from 'fs'
import path from 'path'
import { fileURLToPath } from 'url'
import matter from 'gray-matter'
import { articleConfig } from '../../config/generate-config.js'
import { extractHeadings, estimateReadingMinutes, estimateWordCount } from '../../utils/markdown'
import { articles } from '../../config'

const __filename = fileURLToPath(import.meta.url)
const __dirname = path.dirname(__filename)

// 文章目录路径（使用统一配置）
const rootDir = path.resolve(__dirname, '../../../')
const articleDir = path.join(rootDir, articleConfig.articleDir)

// 生成静态路径
export async function getStaticPaths() {
  // 在函数内部计算路径（使用统一配置）
  const __filename = fileURLToPath(import.meta.url)
  const __dirname = path.dirname(__filename)
  const rootDir = path.resolve(__dirname, '../../../')
  const articleDir = path.join(rootDir, articleConfig.articleDir)

  // 获取所有文章文件
  const files = fs.readdirSync(articleDir).filter((file) => file.endsWith('.md') && !file.startsWith('.'))

  return files.map((file) => {
    const fileSlug = file.replace(/\.md$/, '')
    // Astro 会自动处理 URL 编码，params 中应该使用原始值（未编码）
    // 这样无论浏览器访问时是编码还是未编码，Astro 都能正确匹配
    return {
      params: { slug: fileSlug },
      props: {
        fileSlug: fileSlug,
        fileName: file,
      },
    }
  })
}

interface Props {
  fileSlug: string
  fileName: string
}

// 从 props 获取文件名（getStaticPaths 已经确保匹配）
const { fileSlug, fileName } = Astro.props

// 从 params 获取 slug（Astro 会自动解码，仅用于下方的调试日志）
const slugFromParams = Astro.params.slug

// This is a static build: fileName always comes from the on-disk file list
// in getStaticPaths above, never from user input, so no traversal check is
// needed here (and article slugs/filenames may legitimately contain
// non-ASCII characters or spaces, e.g. "如何优雅的在键盘上使用mac手势.md").
const filePath = path.join(articleDir, fileName)

// 检查文件是否存在
if (!fs.existsSync(filePath)) {
  console.error(`Article file not found: ${filePath}`)
  console.error(`Slug from params: ${slugFromParams}`)
  console.error(`File slug from props: ${fileSlug}`)
  return Astro.redirect('/articles')
}
const fileContent = fs.readFileSync(filePath, 'utf-8')

// 解析 frontmatter 和内容
const { data: frontmatter, content } = matter(fileContent)
const title = frontmatter.title || fileSlug
const created = frontmatter.created || ''
const tags: string[] = frontmatter.tags || []
const banner = frontmatter.banner || ''
const rawCategory = Array.isArray(frontmatter.category) ? frontmatter.category[0] : frontmatter.category
const category = (typeof rawCategory === 'string' && rawCategory.trim()) || articleConfig.defaultCategory

// 日期统一展示为 YYYY-MM-DD（frontmatter 里可能带时分，如 `2025-06-17 13:25`）
const dateMatch = /^(\d{4})[-/](\d{1,2})[-/](\d{1,2})/.exec(String(created).trim())
const displayDate = dateMatch ? `${dateMatch[1]}-${dateMatch[2].padStart(2, '0')}-${dateMatch[3].padStart(2, '0')}` : ''

// 预估字数、阅读时间与目录结构（目录 id 与正文渲染出的 heading id 一致）
const readingMinutes = estimateReadingMinutes(content)
const wordCount = estimateWordCount(content)
const headings = await extractHeadings(content)

// 上一篇 / 下一篇：articles 已按创建时间倒序排列，前一项更新、后一项更旧
const currentIndex = articles.findIndex((a) => a.slug === fileSlug)
const newerArticle = currentIndex > 0 ? articles[currentIndex - 1] : undefined
const olderArticle = currentIndex >= 0 && currentIndex < articles.length - 1 ? articles[currentIndex + 1] : undefined

const categoryHref = `/articles?category=${encodeURIComponent(category)}`
---

<Layout title={title} ogImage={banner || undefined}>
  <div class="min-h-screen bg-background pb-4">
    <div class="px-6">
      <!-- 返回列表 -->
      <div class="max-w-[44rem] mx-auto">
        <a
          href="/articles"
          class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-accent transition-colors mb-8 group">
          <svg class="w-4 h-4 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          返回文章列表
        </a>

        <header class="mb-8 xl:mb-12">
          <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl font-bold text-foreground leading-tight mb-6 flex items-start gap-3">
            <span class="w-1.5 h-8 sm:h-10 shrink-0 bg-accent rounded-full mt-[0.15em] sm:mt-[0.3em]"></span>
            <span class="text-pretty">{title}</span>
          </h1>

          <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-muted-foreground mb-6">
            {
              displayDate && (
                <span class="flex items-center gap-2">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M8 7h8M8 11h8m-6 4h6m2-9a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2z"
                    />
                  </svg>
                  {displayDate}
                </span>
              )
            }
            <a href={categoryHref} class="inline-flex items-center gap-2 hover:text-accent transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h10"></path>
              </svg>
              {category}
            </a>
            {
              tags.map((tag: string) => (
                <a
                  href={`/articles?tag=${encodeURIComponent(tag)}`}
                  class="inline-flex items-center gap-2 hover:text-accent transition-colors">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M7 7h.01M7 3a4 4 0 0 0-4 4v10a4 4 0 0 0 4 4h10a4 4 0 0 0 4-4V7a4 4 0 0 0-4-4H7z"
                    />
                  </svg>
                  {tag}
                </a>
              ))
            }
          </div>

          <div class="flex items-center justify-between py-4 border-y border-border">
            <div class="flex items-center gap-4 text-sm text-muted-foreground">
              <span>{wordCount} 字</span>
              <span class="flex items-center gap-1.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 8v4l3 3m6-3a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"></path>
                </svg>
                {readingMinutes} 分钟
              </span>
            </div>
          </div>
        </header>
      </div>

      <!-- 顶部阅读进度条（窄屏替代左侧轨道上的进度条） -->
      <div
        data-reading-progress
        aria-hidden="true"
        class="pointer-events-none fixed inset-x-0 top-0 z-[55] h-px origin-left scale-x-0 bg-accent xl:hidden">
      </div>

      <!-- 窄屏目录：折叠面板 -->
      {
        headings.length > 0 && (
          <div class="xl:hidden max-w-[44rem] mx-auto mb-4">
            <details open class="group border border-border/60 bg-card/60 rounded-xl">
              <summary class="list-none cursor-pointer px-4 py-3 flex items-center justify-between text-sm text-foreground">
                <span class="inline-flex items-center gap-2">
                  <span class="w-1 h-4 bg-accent rounded-full" />
                  目录
                </span>
                <span class="text-muted-foreground transition-transform group-open:rotate-180">⌄</span>
              </summary>
              <div class="px-4 pb-3 pt-1 border-t border-border/50 max-h-72 overflow-y-auto overscroll-auto toc-scrollbar">
                <TableOfContents headings={headings} variant="list" client:media="(max-width: 1279px)" />
              </div>
            </details>
          </div>
        )
      }

      <div class="relative max-w-[44rem] mx-auto">
        <!-- 横幅图片 -->
        {
          banner && (
            <div class="mb-8">
              <img
                src={banner}
                alt={title}
                loading="lazy"
                decoding="async"
                class="rounded-xl border border-border w-full h-auto object-cover"
              />
            </div>
          )
        }

        <MarkdownContent content={content} />

        <!--
          左侧目录轨道：宽度取 18rem 与「正文左侧剩余空间 − 1.5rem 页边」的较小者，
          窄屏（<xl）不渲染，避免贴到视口边缘。
        -->
        {
          headings.length > 0 && (
            <aside class="hidden xl:block absolute top-0 right-full pr-10 w-[min(18rem,calc(50vw-22rem-1.5rem))] h-full">
              <div class="sticky top-24">
                <TableOfContents headings={headings} variant="rail" title={title} client:media="(min-width: 1280px)" />
              </div>
            </aside>
          )
        }
      </div>

      <footer class="mt-6 pt-4 border-t border-border max-w-[44rem] mx-auto">
        <div class="flex items-center gap-3 mb-8">
          <span class="text-sm text-muted-foreground">标签：</span>
          <div class="flex flex-wrap gap-2">
            {
              tags.map((tag: string) => (
                <a
                  href={`/articles?tag=${encodeURIComponent(tag)}`}
                  class="px-3 py-1 text-xs bg-secondary text-secondary-foreground rounded-full hover:bg-accent hover:text-accent-foreground transition-colors">
                  {tag}
                </a>
              ))
            }
            <a
              href={categoryHref}
              class="px-3 py-1 text-xs bg-secondary text-secondary-foreground rounded-full hover:bg-accent hover:text-accent-foreground transition-colors">
              {category}
            </a>
          </div>
        </div>

        {
          (olderArticle || newerArticle) && (
            <div class="grid sm:grid-cols-2 gap-4">
              {olderArticle ? (
                <a
                  href={`/article/${olderArticle.slug}`}
                  class="group p-4 border border-border rounded-xl hover:border-accent/30 transition-colors">
                  <span class="text-xs text-muted-foreground mb-1 block">上一篇</span>
                  <span class="text-sm font-medium text-foreground group-hover:text-accent transition-colors line-clamp-1">
                    {olderArticle.title}
                  </span>
                </a>
              ) : (
                <div />
              )}
              {newerArticle && (
                <a
                  href={`/article/${newerArticle.slug}`}
                  class="group p-4 border border-border rounded-xl hover:border-accent/30 transition-colors text-right sm:col-start-2">
                  <span class="text-xs text-muted-foreground mb-1 block">下一篇</span>
                  <span class="text-sm font-medium text-foreground group-hover:text-accent transition-colors line-clamp-1">
                    {newerArticle.title}
                  </span>
                </a>
              )}
            </div>
          )
        }
      </footer>
    </div>
  </div>
</Layout>

<script>
  // 窄屏（<xl，没有左侧目录轨道）时，用顶部细线表示阅读进度。
  // 该 script 每页相同，客户端路由下只会执行一次，所以绑定放在 `astro:page-load` 里重做。
  let cleanup = () => {}

  const setup = () => {
    cleanup()
    const bar = document.querySelector('[data-reading-progress]') as HTMLElement | null
    if (!bar) return

    let ticking = false
    const update = () => {
      ticking = false
      const scrollable = document.documentElement.scrollHeight - window.innerHeight
      const ratio = scrollable > 0 ? Math.min(1, Math.max(0, window.scrollY / scrollable)) : 0
      bar.style.transform = `scaleX(${ratio})`
    }
    const onScroll = () => {
      if (ticking) return
      ticking = true
      requestAnimationFrame(update)
    }

    update()
    window.addEventListener('scroll', onScroll, { passive: true })
    window.addEventListener('resize', onScroll)
    cleanup = () => {
      window.removeEventListener('scroll', onScroll)
      window.removeEventListener('resize', onScroll)
    }
  }

  document.addEventListener('astro:page-load', setup)
</script>
