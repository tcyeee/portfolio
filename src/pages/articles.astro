---
import Layout from '../layouts/Layout.astro'
import { articles, personalInfo } from '../config'
import { articleConfig } from '../config/generate-config.js'
import ArticleList from '../components/ArticleList'
import type { CategoryCount, SocialLink } from '../components/ArticleList'

// 分类及其文章数：按文章数倒序，数量相同时按名称排序
const categoryCounts = new Map<string, number>()
for (const article of articles) {
  const name = article.category || articleConfig.defaultCategory
  categoryCounts.set(name, (categoryCounts.get(name) ?? 0) + 1)
}
const categories: CategoryCount[] = [...categoryCounts.entries()]
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name, 'zh-CN'))

// 所有标签（去重后按中文排序）
const tags = [...new Set(articles.flatMap((article) => article.tags || []))].sort((a, b) => a.localeCompare(b, 'zh-CN'))

const links: SocialLink[] = [
  personalInfo.github && { label: 'GitHub', href: personalInfo.github, icon: 'github' as const },
  personalInfo.twitter && { label: 'X', href: personalInfo.twitter, icon: 'x' as const },
  personalInfo.bilibili && { label: 'Bilibili', href: personalInfo.bilibili, icon: 'bilibili' as const },
  personalInfo.redNote && { label: '小红书', href: personalInfo.redNote, icon: 'rednote' as const },
  personalInfo.email && { label: 'Email', href: `mailto:${personalInfo.email}`, icon: 'mail' as const },
].filter(Boolean) as SocialLink[]
---

<Layout title="文章">
  <ArticleList
    client:load
    articles={articles}
    categories={categories}
    tags={tags}
    pageSize={articleConfig.pageSize}
    profile={{
      name: personalInfo.name,
      avatar: personalInfo.avatar,
      motto: personalInfo.motto,
      status: personalInfo.status,
      links,
    }}
  />
</Layout>
