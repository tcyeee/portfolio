---
import Layout from '../layouts/Layout.astro'
import { projects, personalInfo, apps, homeDisplayCount } from '../config'
import ProjectCard from '../components/ProjectCard'
import Hero from '../components/Hero.astro'
import ObsidianReveal from '../components/ObsidianReveal'

const obsidianProjects = projects.filter((project) => project.tags?.includes('Obsidian'))
const otherProjects = projects.filter((project) => !project.tags?.includes('Obsidian'))
const featuredProjects = otherProjects.slice(0, homeDisplayCount)

// 首页 APP 图标区域与「其他开源作品」卡片合并：按 GitHub 地址匹配项目对应的 APP 图标
const normalizeUrl = (url?: string) => (url ?? '').trim().toLowerCase().replace(/\/$/, '')
const appByGithubUrl = new Map(apps.filter((app) => app.url).map((app) => [normalizeUrl(app.url), app]))
---

<Layout title={`${personalInfo.name} | ${personalInfo.title}`} description={personalInfo.bio}>
  <Hero>
    <div class="text-center md:text-left">
      <h1 class="text-5xl font-bold mb-4 text-gray-900 dark:text-white">
        {personalInfo.name}
      </h1>
      <p class="text-2xl text-gray-600 dark:text-gray-300 mb-4">
        {personalInfo.title}
      </p>
      <p class="text-lg text-gray-500 dark:text-gray-400 max-w-2xl">
        {personalInfo.bio}
      </p>
      <div class="flex gap-4 justify-center md:justify-start mt-8">
        {
          personalInfo.github && (
            <a
              href={personalInfo.github}
              target="_blank"
              rel="noopener noreferrer"
              class="px-6 py-3 bg-gray-900 dark:bg-gray-100 text-white dark:text-gray-900 rounded-lg hover:bg-gray-800 dark:hover:bg-gray-200 transition-colors">
              GitHub
            </a>
          )
        }
        {
          personalInfo.email && (
            <a
              href={`mailto:${personalInfo.email}`}
              class="px-6 py-3 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-colors">
              联系我
            </a>
          )
        }
      </div>
    </div>
  </Hero>

  <!-- Obsidian 区域：下滑时图标与背景画布联动放大，再向左让位展示插件列表 -->
  <ObsidianReveal client:visible projects={obsidianProjects} />

  <div id="second-screen" class="container mx-auto px-4 py-16">
    <!-- Featured Projects（含首页 APP 图标，按 GitHub 地址匹配后悬浮展示在卡片封面图上） -->
    <section class="mt-[10vh] mb-20">
      <h2 class="text-3xl font-bold mb-8 text-center text-gray-900 dark:text-white">其他开源作品</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          featuredProjects.map((project) => (
            <ProjectCard client:visible project={project} app={appByGithubUrl.get(normalizeUrl(project.githubUrl))} />
          ))
        }
      </div>
      <div class="text-center mt-8">
        <a
          href="/projects"
          class="inline-block px-6 py-3 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-colors">
          查看所有作品 →
        </a>
      </div>
    </section>

    <!-- UX 交互 -->
    <section class="mb-20">
      <h2 class="text-3xl font-bold mb-8 text-center text-gray-900 dark:text-white">UX 交互</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {
          [
            { href: '/ux/transition', title: '页面切换动画' },
            { href: '/ux/3d-model', title: '3D 模型交互' },
            { href: '/ux/gallery', title: '无限滚动画廊' },
          ].map((item) => (
            <a
              href={item.href}
              class="block rounded-lg overflow-hidden border border-gray-200 dark:border-gray-700 shadow-sm hover:shadow-md transition-shadow bg-white dark:bg-gray-800">
              <div class="flex items-center gap-1.5 px-4 py-2.5 bg-gray-100 dark:bg-gray-900 border-b border-gray-200 dark:border-gray-700">
                <span class="w-3 h-3 rounded-full bg-red-400" />
                <span class="w-3 h-3 rounded-full bg-yellow-400" />
                <span class="w-3 h-3 rounded-full bg-green-400" />
              </div>
              <div class="flex items-center justify-center h-40 text-gray-500 dark:text-gray-400">{item.title}</div>
            </a>
          ))
        }
      </div>
    </section>

    <!-- Skills Section -->
    <section>
      <h2 class="text-3xl font-bold mb-8 text-center text-gray-900 dark:text-white">技术栈</h2>
      <div class="flex flex-wrap gap-3 justify-center">
        {
          personalInfo.skills.map((skill) => (
            <span class="px-4 py-2 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700">
              {skill}
            </span>
          ))
        }
      </div>
    </section>
  </div>
</Layout>
